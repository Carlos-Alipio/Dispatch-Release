# Copie este arquivo para .env e preencha os valores.
# O .env é ignorado pelo git; nunca commite segredos.

# Gere uma chave com:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# True apenas em desenvolvimento. Em produção use False.
DJANGO_DEBUG=True

# Hosts permitidos, separados por vírgula (obrigatório com DEBUG=False).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Chave da API do OpenWeatherMap (camada de precipitação do mapa).
# Crie a sua em https://home.openweathermap.org/api_keys
OWM_API_KEY=

# Nível de log do backend (DEBUG, INFO, WARNING, ERROR).
LOG_LEVEL=INFO
